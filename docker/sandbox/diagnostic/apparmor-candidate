abi <abi/3.0>,
#include <tunables/global>
profile kairos-runtime-candidate flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  # Disallow AF_ALG (Linux kernel crypto API); see https://copy.fail/
  deny network alg,
  capability,
  file,
  umount /oldroot/,
  umount /,
  # Host (privileged) processes may send signals to container processes.
  signal (receive) peer=unconfined,
  # runc may send signals to container processes (for "docker stop").
  signal (receive) peer=runc,
  # crun may send signals to container processes (for "docker stop" when used with crun OCI runtime).
  signal (receive) peer=crun,
  # dockerd may send signals to container processes (for "docker kill").
  signal (receive) peer="unconfined",
  # Container processes may send signals amongst themselves.
  signal (send,receive) peer="kairos-runtime-candidate",

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  # Derived from Codex rust-v0.153.4 vendored bubblewrap.c and bind-mount.c.
  mount options=(rw, silent, rslave) -> /,
  mount fstype=tmpfs options=(rw, nosuid, nodev) -> /tmp/,
  mount fstype=tmpfs options=(rw, nosuid, nodev) -> /newroot/{,**},
  mount fstype=proc options=(rw, nosuid, nodev, noexec) -> /newroot/proc/,
  mount fstype=devpts options=(rw, nosuid, noexec) -> /newroot/dev/pts/,
  mount options=(rw, silent, rbind) /tmp/newroot/ -> /tmp/newroot/,
  mount options=(rw, silent, rbind) /oldroot/{,**} -> /newroot/{,**},
  mount options=(rw, silent, rbind) /newroot/proc/** -> /newroot/proc/**,
  mount options=(rw, silent, rprivate) -> /oldroot/,
  pivot_root oldroot=/tmp/oldroot/ /tmp/,
  pivot_root oldroot=/newroot/ /newroot/,
  # Exact remount combinations: nosuid always required; other flags preserved.
  mount options=(rw, remount, bind, silent, nosuid) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, relatime) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, nodiratime) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, nodiratime, relatime) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, noatime) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, noatime, relatime) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, noatime, nodiratime) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, noatime, nodiratime, relatime) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, noexec) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, noexec, relatime) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, noexec, nodiratime) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, noexec, nodiratime, relatime) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, noexec, noatime) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, noexec, noatime, relatime) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, noexec, noatime, nodiratime) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, noexec, noatime, nodiratime, relatime) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, nodev) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, nodev, relatime) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, nodev, nodiratime) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, nodev, nodiratime, relatime) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, nodev, noatime) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, nodev, noatime, relatime) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, nodev, noatime, nodiratime) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, nodev, noatime, nodiratime, relatime) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, nodev, noexec) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, nodev, noexec, relatime) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, nodev, noexec, nodiratime) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, nodev, noexec, nodiratime, relatime) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, nodev, noexec, noatime) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, nodev, noexec, noatime, relatime) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, nodev, noexec, noatime, nodiratime) -> /newroot/{,**},
  mount options=(rw, remount, bind, silent, nosuid, nodev, noexec, noatime, nodiratime, relatime) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, relatime) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, nodiratime) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, nodiratime, relatime) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, noatime) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, noatime, relatime) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, noatime, nodiratime) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, noatime, nodiratime, relatime) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, noexec) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, noexec, relatime) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, noexec, nodiratime) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, noexec, nodiratime, relatime) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, noexec, noatime) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, noexec, noatime, relatime) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, noexec, noatime, nodiratime) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, noexec, noatime, nodiratime, relatime) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, nodev) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, nodev, relatime) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, nodev, nodiratime) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, nodev, nodiratime, relatime) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, nodev, noatime) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, nodev, noatime, relatime) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, nodev, noatime, nodiratime) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, nodev, noatime, nodiratime, relatime) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, nodev, noexec) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, nodev, noexec, relatime) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, nodev, noexec, nodiratime) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, nodev, noexec, nodiratime, relatime) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, nodev, noexec, noatime) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, nodev, noexec, noatime, relatime) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, nodev, noexec, noatime, nodiratime) -> /newroot/{,**},
  mount options=(ro, remount, bind, silent, nosuid, nodev, noexec, noatime, nodiratime, relatime) -> /newroot/{,**},

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # allow processes within the container to trace each other,
  # provided all other LSM and yama setting allow it.
  ptrace (trace,tracedby,read,readby) peer="kairos-runtime-candidate",
}
