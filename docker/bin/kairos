#!/bin/bash
# Shim de `docker exec` — a correção de um bug de sintoma contraditório.
#
# O BUG. Os processos supervisionados rodam como o usuário não-privilegiado
# `kairos` (UID 10000). Um `docker exec <c> kairos ...` roda como ROOT, e
# qualquer arquivo escrito sob $KAIROS_HOME — auth.json, .env, config.yaml —
# fica root-owned e ILEGÍVEL para o gateway.
#
# A manifestação clássica: o usuário roda `docker exec <c> kairos login`, que
# grava auth.json como root:root modo 0600. A partir daí o gateway responde
# "authentication failed" em toda mensagem — ENQUANTO
# `docker exec <c> kairos chat -q ping` continua funcionando, porque root lê o
# próprio arquivo. O sintoma contraditório é o que tornava o bug difícil: a
# mesma ferramenta funciona por um caminho e falha por outro.
#
# A CORREÇÃO. Este shim fica em /opt/kairos/bin, PRIMEIRO no PATH. Invocado
# como root, derruba para o usuário `kairos` antes de executar o binário real.
#
# CUSTO. Um fork extra apenas no caminho docker-exec-como-root; zero mudança
# de comportamento em todos os outros.
set -euo pipefail

REAL="/opt/kairos/.venv/bin/kairos"
KAIROS_USER="${KAIROS_USER:-kairos}"

# Não-root passa direto: processos supervisionados, `docker exec --user kairos`,
# subagentes. Nenhuma troca de privilégio, nenhum fork.
if [ "$(id -u)" -ne 0 ]; then
  exec "$REAL" "$@"
fi

# Opt-out explícito, para sessão de diagnóstico. O DEFAULT é derrubar.
case "$(printf '%s' "${KAIROS_DOCKER_EXEC_AS_ROOT:-}" | tr '[:upper:]' '[:lower:]')" in
  1|true|yes)
    exec "$REAL" "$@"
    ;;
esac

# s6-setuidgid TAMBÉM por caminho absoluto, e pela mesma razão que o binário
# da venv: num `docker exec` cru o PATH não inclui /command — quem o semeia é
# o /init, que não roda neste caminho. Depender do PATH aqui faz o shim falhar
# exatamente no cenário para o qual ele existe.
S6_SETUIDGID=""
for candidate in /command/s6-setuidgid /package/admin/s6/command/s6-setuidgid; do
  if [ -x "$candidate" ]; then
    S6_SETUIDGID="$candidate"
    break
  fi
done
if [ -z "$S6_SETUIDGID" ] && command -v s6-setuidgid >/dev/null 2>&1; then
  S6_SETUIDGID="$(command -v s6-setuidgid)"
fi
if [ -z "$S6_SETUIDGID" ] && [ -x /usr/bin/setpriv ]; then
  # Fallback fora do s6. Mesma semântica: derruba UID, GID e grupos
  # suplementares antes de executar.
  exec /usr/bin/setpriv --reuid "$KAIROS_USER" --regid "$KAIROS_USER" \
       --clear-groups "$REAL" "$@"
fi

# Não conseguimos derrubar privilégio: RECUSAMOS, em vez de rodar como root.
#
# Rodar como root "com um aviso" recria precisamente o bug que este shim
# existe para prevenir — e o recria em silêncio prático, porque ninguém lê o
# stderr de um `docker exec ... kairos login`. O sintoma só aparece uma hora
# depois, como falha de autenticação contraditória. Falhar agora, alto, é
# melhor que corromper agora e confundir depois.
#
# Quem realmente quer root tem o opt-out explícito acima.
if [ -z "$S6_SETUIDGID" ]; then
  echo "kairos: não foi possível derrubar privilégio para '$KAIROS_USER'."      >&2
  echo "kairos: s6-setuidgid e setpriv indisponíveis. Executar como root aqui"  >&2
  echo "kairos: gravaria arquivos root-owned em \$KAIROS_HOME e quebraria o"    >&2
  echo "kairos: gateway de forma difícil de diagnosticar. Recusando."           >&2
  echo "kairos: Se é isso mesmo que você quer, use:"                            >&2
  echo "kairos:   KAIROS_DOCKER_EXEC_AS_ROOT=1 kairos $*"                       >&2
  exit 77
fi

# Execução por CAMINHO ABSOLUTO do binário da venv. É isso que impede recursão
# independentemente do estado do PATH — o segundo salto não pode reentrar
# aqui. Nenhuma variável sentinela é necessária.
exec "$S6_SETUIDGID" "$KAIROS_USER" "$REAL" "$@"
