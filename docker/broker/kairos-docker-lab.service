[Unit]
Description=Kairos Docker broker (dedicated pilot)
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/projetos/kairos
Environment=KAIROS_HOME=%h/.local/share/kairos-docker-lab
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStartPre=%h/projetos/kairos/scripts/check-runtime-disk.sh
ExecStart=%h/projetos/kairos/.venv/bin/kairos runtime serve
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
