[Unit]
Description=Kairos Docker broker (dedicated pilot)
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/projetos/kairos
Environment=KAIROS_HOME=%h/.local/share/kairos-docker-lab
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStartPre=%h/projetos/kairos/scripts/check-runtime-disk.sh
ExecStartPre=/usr/bin/sg docker -c 'exec /usr/bin/setpriv --no-new-privs /usr/bin/test -w /var/run/docker.sock'
ExecStart=/usr/bin/sg docker -c 'exec /usr/bin/setpriv --no-new-privs "%h/projetos/kairos/.venv/bin/kairos" runtime serve'
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=90
UMask=0077
# sg selects an already-authorized group before setpriv locks the broker down.
# Setting NoNewPrivileges here would prevent sg from selecting that group.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
